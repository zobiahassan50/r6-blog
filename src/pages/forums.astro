---
import BaseLayout from '../layouts/BaseLayout.astro'
import { ForumsPage } from '../views/ForumsPage'
import { SEO } from '../data/site'
import { breadcrumbJsonLd } from '../lib/seo'

const initialQuery = Astro.url.searchParams.get('q') ?? ''

const jsonLdExtra = [
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Forums', path: '/forums' },
  ]),
]
---

<BaseLayout seo={SEO.forums} jsonLdExtra={jsonLdExtra}>
  <ForumsPage client:idle initialQuery={initialQuery} />
</BaseLayout>
