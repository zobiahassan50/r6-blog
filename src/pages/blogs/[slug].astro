---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { BlogPostPage } from '../../views/BlogPostPage'
import { BLOGS, blogPath, getBlog } from '../../data/blogs'
import { SITE_URL, type PageSeo } from '../../data/site'
import { guideOgImage } from '../../data/og'
import { articleJsonLd, breadcrumbJsonLd, howToJsonLd } from '../../lib/seo'

export function getStaticPaths() {
  return BLOGS.map((post) => ({
    params: { slug: post.slug },
  }))
}

const { slug } = Astro.params
const post = getBlog(slug!)

if (!post) {
  return Astro.redirect('/404')
}

const ogImage = guideOgImage(post.slug)
const absoluteMedia = (path: string) => `${SITE_URL}${path}`
const pageUrl = `${SITE_URL}${blogPath(post.slug)}`

const seo: PageSeo = {
  title: post.metaTitle,
  description: post.metaDescription,
  path: blogPath(post.slug),
  ogType: 'article',
  image: ogImage,
  imageAlt: `${post.title} — R6 Siege Cheats blog`,
  robots: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
}

const howToLd = howToJsonLd(post, pageUrl, absoluteMedia(ogImage))

const jsonLdExtra = [
  articleJsonLd(post, pageUrl, absoluteMedia(ogImage)),
  ...(howToLd ? [howToLd] : []),
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Blogs', path: '/blogs/' },
    { name: post.title, path: blogPath(post.slug) },
  ]),
]
---

<BaseLayout seo={seo} jsonLdExtra={jsonLdExtra}>
  <BlogPostPage client:visible slug={post.slug} />
</BaseLayout>
