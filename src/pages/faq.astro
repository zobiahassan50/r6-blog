---
import BaseLayout from '../layouts/BaseLayout.astro'
import { FaqPage } from '../views/FaqPage'
import { SEO, absoluteUrl } from '../data/site'
import { SITE_FAQS } from '../data/faqs'
import { breadcrumbJsonLd, faqPageJsonLd } from '../lib/seo'

const jsonLdExtra = [
  faqPageJsonLd(SITE_FAQS, absoluteUrl('/faq')),
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'FAQ', path: '/faq' },
  ]),
]
---

<BaseLayout seo={SEO.faq} jsonLdExtra={jsonLdExtra}>
  <FaqPage client:visible />
</BaseLayout>
